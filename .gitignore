# Allow-list: only what is named here can ever be published. Research data, samples, outputs and third-party source stay private.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE.md
!/CONTRIBUTING.md
!/VERSION
!/requirements.txt

!/src/
/src/*
!/src/colorforge/
!/src/colorforge_app/

!/data/
/data/*
!/data/looks/
!/data/stocks/
/data/stocks/*
!/data/stocks/film_physics.json
!/data/stocks/kodachrome_25.cfstock.json
!/data/stocks/kodachrome_64.cfstock.json
!/data/stocks/kodachrome_200.cfstock.json
!/data/stocks/velvia_50_sheet.cfstock.json
!/data/stocks/velvia_100f.cfstock.json
!/data/stocks/provia_100f_sheet.cfstock.json
!/data/stocks/astia_100f.cfstock.json
!/data/stocks/ektachrome_e100.cfstock.json
!/data/stocks/ektachrome_e100g.cfstock.json
!/data/stocks/ektachrome_e100vs.cfstock.json
!/data/stocks/ektachrome_epn.cfstock.json
!/data/stocks/ektachrome_100d_sheet.cfstock.json

!/env/
/env/*
!/env/setup.bat
!/env/run_colorforge.bat

!/tests/
/tests/*
!/tests/test_film.py

!/third_party/
/third_party/*
!/third_party/PMRID/
/third_party/PMRID/*
!/third_party/PMRID/LICENSE
!/third_party/PMRID/models/
/third_party/PMRID/models/*
!/third_party/PMRID/models/torch_pretrained.ckp
!/third_party/RealESRGAN_compact/
/third_party/RealESRGAN_compact/*
!/third_party/RealESRGAN_compact/LICENSE
!/third_party/RealESRGAN_compact/realesr-general-x4v3.pth

__pycache__/
*.pyc
